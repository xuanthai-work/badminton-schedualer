# Copy to .env.local and fill in real values.
# .env.local is gitignored; .env.example is committed.

# Supabase project base URL (no /rest/v1 suffix).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key (from Project Settings -> API).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (Project Settings -> API) - SECRET, server-only.
# Optional: only needed by server-side jobs that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
