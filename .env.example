# Copy to .env.local and fill in real values.
# .env.local is gitignored; .env.example is committed.

# Supabase project base URL (no /rest/v1 suffix).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key (from Project Settings -> API).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Web Push (optional; needed for push notifications) ---
# Generate the key pair with: npx web-push generate-vapid-keys
# Public key is exposed to the client.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# Private key — SECRET, server-only. Never commit the real value.
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact subject for the push service (mailto: or https URL).
VAPID_SUBJECT=mailto:you@example.com
# Shared secret the Supabase webhook sends as the x-webhook-secret header.
PUSH_WEBHOOK_SECRET=a-long-random-string
# Supabase service role key (Project Settings -> API) — SECRET, server-only.
# Lets /api/push/notify read every user's push subscriptions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
